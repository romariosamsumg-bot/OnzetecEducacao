{
  "name": "onzetec-educacao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:local": "tsx scripts/db-migrate.ts --local",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:dev": "tsx scripts/db-seed.ts --dev-users",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "media:demo": "bash scripts/generate-demo-media.sh",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run test:e2e",
    "db:setup-sql": "tsx scripts/build-setup-sql.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tus-js-client": "^4.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
