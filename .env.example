# =====================================================================
# Onzetec Educação — variáveis de ambiente (copie para .env.local)
# NUNCA versione o arquivo com valores reais. Variáveis NEXT_PUBLIC_* vão para o navegador.
# =====================================================================

# --- Essenciais -------------------------------------------------------
# Banco PostgreSQL. No Supabase: "Connection string" do pooler em modo transação (porta 6543).
DATABASE_URL=postgres://onzetec:onzetec_local_dev@localhost:5432/onzetec
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Segredo para assinar cookies de desenvolvimento e links temporários. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres

# --- Autenticação -----------------------------------------------------
# "supabase" em produção. "dev" = login simplificado SEM senha (somente desenvolvimento local).
AUTH_MODE=dev
# Somente para testes E2E locais em build de produção. NUNCA "true" em produção real.
DEV_AUTH_ALLOW_PRODUCTION_BUILD=false
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (ou anon key) do projeto Supabase.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave de serviço (somente servidor): Storage e exclusão de contas (LGPD).
SUPABASE_SERVICE_ROLE_KEY=

# --- Arquivos ---------------------------------------------------------
# "local" (pasta ./storage, desenvolvimento) ou "supabase" (produção)
STORAGE_PROVIDER=local
SUPABASE_PUBLIC_BUCKET=public-media
SUPABASE_PRIVATE_BUCKET=private-files

# --- Vídeo ------------------------------------------------------------
# "true" libera os vídeos de demonstração em /public/demo. Em produção real: false.
DEMO_MEDIA_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Código do subdomínio customer-XXXX.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Chave de assinatura do Stream (POST /stream/keys): id e JWK (base64 do campo "jwk")
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# --- Pagamentos -------------------------------------------------------
# "none" = vendas desativadas (a interface avisa). "mercadopago" = ativo.
BILLING_PROVIDER=none
# Use primeiro as credenciais de TESTE do Mercado Pago.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (painel do Mercado Pago > Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Somente no ambiente de testes: e-mail do usuário comprador de teste do Mercado Pago
MERCADOPAGO_TEST_PAYER_EMAIL=

# --- Operação ---------------------------------------------------------
# Protege /api/cron/reconcile (Authorization: Bearer <valor>). Gere com: openssl rand -hex 24
CRON_SECRET=
SUPPORT_EMAIL=
